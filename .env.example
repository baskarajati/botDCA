BOT_ENV=development
BOTDCA_UID=10001
BOTDCA_GID=10001
BOT_OPERATOR_TOKEN=
BOT_OPERATOR_TOKEN_FILE=
BOT_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
BOT_TRIAL_EQUITY_USDT=100
BOT_MAINNET_PREFLIGHT_APPROVED=false
BOT_LIVE_TRADING=false
BOT_START_LIVE_WORKER=false
BOT_WORKER_INTERVAL_SECONDS=2
BOT_SYMBOL=HYPEUSDT
BOT_LEVERAGE=24
BOT_BASE_MARGIN_USDT=1
BOT_TP_PERCENT=1.09
BOT_REENTRY_DELAY_SECONDS=30
BOT_MAX_DCA_LEVEL=8
BOT_MAX_STRATEGY_MARGIN_USDT=80
BOT_MIN_AVAILABLE_BALANCE_USDT=0
BOT_MIN_AVAILABLE_EQUITY_RATIO=0.20

# Strategy family. The live ladder never includes research-only DCA levels.
BOT_STRATEGY_VERSION_ID=greensynergy-reconstructed-v1

# Account-level portfolio guards, evaluated across every enabled symbol
# against one Bybit Unified Account. These are what bound correlated deep DCA.
BOT_MAX_TOTAL_BOT_MARGIN_USDT=240
BOT_MAX_TOTAL_BOT_NOTIONAL_USDT=6000
BOT_DEEP_DCA_LEVEL=5
BOT_MAX_SIMULTANEOUS_DEEP_BASKETS=1
# Optional portfolio floating-loss ceiling; leave empty to disable.
BOT_MAX_TOTAL_FLOATING_LOSS_USDT=

# First-trial mode. These can only tighten limits, never loosen them.
BOT_TRIAL_MODE=false
BOT_TRIAL_MAX_ACTIVE_SYMBOLS=1
BOT_TRIAL_MAX_DCA_LEVEL=4
BOT_TRIAL_MAX_PORTFOLIO_MARGIN_USDT=25
BOT_TRIAL_MANUAL_RESUME_AFTER_RESTART=true
BOT_TRIAL_PAUSE_AFTER_CYCLE=true

# Alerting. The journal sink is always active; the webhook is optional and
# vendor-neutral. A failing channel never interrupts reconciliation.
BOT_ALERT_WEBHOOK_URL=
BOT_ALERT_MIN_SEVERITY=warning
BOT_ALERT_DEDUPE_SECONDS=900

DATABASE_URL=postgresql+psycopg://botdca:botdca@db:5432/botdca
DATABASE_URL_FILE=
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false
BOT_CREDENTIAL_KEY_FILE=/run/secrets/botdca_credential_key
BOT_CREDENTIAL_STORE_PATH=/var/lib/botdca/secrets/bybit.enc
BOT_TRUSTED_HTTPS_PROXY=false
